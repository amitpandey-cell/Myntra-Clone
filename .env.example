PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/stylekart
JWT_SECRET=

# Optional: set these before running npm run seed to create the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StyleKart Admin

# Optional email delivery for password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Razorpay test-mode credentials only (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
